@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row fade-in">
    <div class="col-md-12 mb-4">
        <h1 class="text-center text-primary">Admin Dashboard</h1>
        <p class="text-center text-muted">Welcome to the Deepotex Administration Panel</p>
    </div>
</div>

<div class="row fade-in">
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 product-card h-100">
            <div class="card-body text-center">
                <i class="fa fa-box fa-3x text-primary mb-3"></i>
                <h3 class="card-title">Products</h3>
                <p class="card-text">Manage your product catalog. Add, edit, or remove products.</p>
                <a asp-action="Index" asp-controller="Product" asp-area="Admin" class="btn btn-premium w-100">Manage Products</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 product-card h-100">
            <div class="card-body text-center">
                <i class="fa fa-envelope fa-3x text-success mb-3"></i>
                <h3 class="card-title">Messages</h3>
                <p class="card-text">View messages from the contact form (Coming Soon).</p>
                <button class="btn btn-secondary w-100" disabled>Coming Soon</button>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 product-card h-100">
            <div class="card-body text-center">
                <i class="fa fa-users fa-3x text-info mb-3"></i>
                <h3 class="card-title">Users</h3>
                <p class="card-text">Manage admin users (Coming Soon).</p>
                <button class="btn btn-secondary w-100" disabled>Coming Soon</button>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4 fade-in">
    <div class="col-12 text-center">
        <form asp-controller="Account" asp-action="Logout" method="post" asp-area="">
            <button type="submit" class="btn btn-danger">
                <i class="fa fa-sign-out-alt"></i> Logout
            </button>
        </form>
    </div>
</div>
