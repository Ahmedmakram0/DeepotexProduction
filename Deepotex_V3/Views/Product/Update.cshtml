@model Deepotex.core.ViewModels.ProductViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Update Product</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Update" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Name -->
                        <div class="form-group mb-4">
                            <label asp-for="Name" class="form-label fw-bold">Product Name</label>
                            <input asp-for="Name" class="form-control form-control-lg" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- SmallDescription -->
                        <div class="form-group mb-4">
                            <label asp-for="SmallDescription" class="form-label fw-bold">Short Description</label>
                            <input asp-for="SmallDescription" class="form-control" maxlength="100" required />
                            <small class="form-text text-muted">Maximum 100 characters</small>
                            <span asp-validation-for="SmallDescription" class="text-danger"></span>
                        </div>

                        <!-- Description -->
                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Full Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" maxlength="500" required></textarea>
                            <small class="form-text text-muted">Maximum 500 characters</small>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Features (Dynamic List) -->
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Features</label>
                            <div id="features-container">
                                @if (Model.Features != null)
                                {
                                    for (int i = 0; i < Model.Features.Count; i++)
                                    {
                                        <div class="input-group mb-2">
                                            <input type="text" name="Features[@i]" class="form-control" value="@Model.Features[i]" required />
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-danger remove-feature">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <button type="button" id="add-feature" class="btn btn-secondary mt-2">
                                <i class="fas fa-plus"></i> Add Feature
                            </button>
                            <span class="text-danger" id="features-error"></span>
                        </div>

                        <!-- Price -->
                        <div class="form-group mb-4">
                            <label asp-for="Price" class="form-label fw-bold">Price</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required />
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <!-- Existing Images -->
                        @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                        {
                            <div class="form-group mb-4">
                                <label class="form-label fw-bold">Existing Images</label>
                                <div class="row g-2" id="existing-images">
                                    @for (int i = 0; i < Model.ImageUrls.Count; i++)
                                    {
                                        <div class="col-md-4 mb-2 existing-image-container">
                                            <div class="card h-100">
                                                <img src="@Model.ImageUrls[i]" class="card-img-top img-fluid" alt="Product Image @(i+1)" />
                                                <div class="card-footer p-2 text-center">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input" id="keepImage_@i" name="KeepImages" value="@i" checked />
                                                        <label class="form-check-label" for="keepImage_@i">Keep</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <input type="hidden" name="ExistingImageUrls[@i]" value="@Model.ImageUrls[i]" />
                                        </div>
                                    }
                                </div>
                                <small class="form-text text-muted">Uncheck the box to remove an image</small>
                            </div>
                        }

                        <!-- New Images Upload -->
                        <div class="form-group mb-4">
                            <label asp-for="Images" class="form-label fw-bold">Add New Images</label>
                            <div class="custom-file">
                                <input asp-for="Images" type="file" class="form-control" accept="image/*" multiple onchange="previewImages(event)" />
                                <small class="form-text text-muted">You can select multiple new images (hold Ctrl/Cmd while selecting)</small>
                                <span asp-validation-for="Images" class="text-danger"></span>
                            </div>
                            <div id="imagesPreviewContainer" class="mt-3 row g-2">
                                <!-- Preview images will be shown here -->
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save"></i> Update Product
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Add feature input dynamically
        let featureIndex = @(Model.Features?.Count ?? 0);
        document.getElementById('add-feature').addEventListener('click', function () {
            const container = document.getElementById('features-container');
            const newFeature = `
                <div class="input-group mb-2">
                    <input type="text" name="Features[${featureIndex}]" class="form-control" placeholder="Enter a feature" required />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-danger remove-feature">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', newFeature);
            featureIndex++;
        });

        // Remove feature input
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-feature') || e.target.closest('.remove-feature')) {
                const featureGroup = e.target.closest('.input-group');
                if (featureGroup) {
                    featureGroup.remove();
                }
            }
        });

        // Multiple images preview
        function previewImages(event) {
            const container = document.getElementById('imagesPreviewContainer');
            container.innerHTML = '';
            
            if (event.target.files) {
                Array.from(event.target.files).forEach((file, index) => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const previewDiv = document.createElement('div');
                        previewDiv.className = 'col-md-4 mb-2';
                        
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = 'img-fluid rounded';
                        img.style.maxHeight = '150px';
                        img.alt = `New Image Preview ${index + 1}`;
                        
                        previewDiv.appendChild(img);
                        container.appendChild(previewDiv);
                    }
                    reader.readAsDataURL(file);
                });
            }
        }

        // Form validation
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    
                    // Check if we have at least one image (either existing kept or new)
                    const existingImages = document.querySelectorAll('input[name="KeepImages"]:checked').length;
                    const newImages = document.querySelector('input[type="file"]').files.length;
                    
                    if (existingImages === 0 && newImages === 0) {
                        event.preventDefault();
                        event.stopPropagation();
                        
                        // Display error message
                        const errorMsg = document.createElement('div');
                        errorMsg.className = 'alert alert-danger mt-3';
                        errorMsg.textContent = 'Please keep at least one existing image or upload a new one';
                        
                        const imageSection = document.querySelector('.form-group:has(input[type="file"])');
                        if (!document.getElementById('image-error')) {
                            errorMsg.id = 'image-error';
                            imageSection.appendChild(errorMsg);
                        }
                    } else if (document.getElementById('image-error')) {
                        document.getElementById('image-error').remove();
                    }
                    
                    form.classList.add('was-validated');
                }, false);
            });
        })();
        
        // Display TempData alert if exists
        document.addEventListener('DOMContentLoaded', function() {
            const tempDataSuccess = '@TempData["Success"]';
            const tempDataError = '@TempData["Error"]';
            
            if (tempDataSuccess && tempDataSuccess !== '') {
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-success alert-dismissible fade show mt-3';
                alertDiv.innerHTML = `
                    ${tempDataSuccess}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                document.querySelector('.card-body').prepend(alertDiv);
                
                // Auto-dismiss after 5 seconds
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alertDiv);
                    bsAlert.close();
                }, 5000);
            }
            
            if (tempDataError && tempDataError !== '') {
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
                alertDiv.innerHTML = `
                    ${tempDataError}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                document.querySelector('.card-body').prepend(alertDiv);
            }
        });
    </script>
}