@{
    ViewData["Title"] = "About Deepotex - Premium Adhesive Solutions Since 2005";
}

<!-- Skip to content link for accessibility -->
<a href="#main-content" class="skip-to-content">Skip to main content</a>

<!-- HEADER -->
<header class="item header margin-top-0" style="background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('@ViewBag.RandomBackgroundImage')">
    <div class="wrapper">
        <div class="container">
            <div class="row">
                <div class="col-md-12 text-center">
                    <div class="text-pageheader">
                        <div class="subtext-image" data-scrollreveal="enter bottom over 1.7s after 0.0s">
                            About Deepotex
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- CONTENT -->
<section class="item content" id="main-content">
    <div class="container toparea">
        <div class="underlined-title">
            <div class="editContent">
                <h1 class="text-center latestitems">The Deepotex Story</h1>
            </div>
            <div class="wow-hr type_short">
                <span class="wow-hr-h">
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                </span>
            </div>
        </div>
        
        <!-- Company Story -->
        <div class="row">
            <div class="col-md-8 offset-md-2 fade-in">
                <div class="company-story">
                    <p class="lead">
                        Deepotex Solutions was founded in 2005 with a simple mission: to provide high-quality industrial adhesives and sealants that meet the demanding needs of modern construction and manufacturing.
                    </p>
                    <p>
                        What began as a small family business has grown into a trusted supplier for construction companies, manufacturers, and industrial clients across the Middle East. Our commitment to quality, innovation, and customer satisfaction has been the cornerstone of Deepotex's success.
                    </p>
                    <p>
                        Today, Deepotex proudly offers a comprehensive range of adhesive solutions designed to meet the specific requirements of various industries, from construction and automotive to electronics and general manufacturing.
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Mission and Vision -->
        <div class="row mission-vision-section">
            <div class="col-md-6 fade-in">
                <div class="mission-box">
                    <div class="icon-container">
                        <i class="fa fa-bullseye"></i>
                    </div>
                    <h2>Our Mission</h2>
                    <p>
                        To provide innovative adhesive solutions that help our customers build stronger, more efficient, and more sustainable products. We strive to exceed expectations through technical excellence, responsive service, and continuous improvement.
                    </p>
                </div>
            </div>
            <div class="col-md-6 fade-in">
                <div class="vision-box">
                    <div class="icon-container">
                        <i class="fa fa-eye"></i>
                    </div>
                    <h2>Our Vision</h2>
                    <p>
                        To be the leading provider of adhesive technologies in the Middle East, recognized for our product quality, technical expertise, and commitment to sustainable practices. We aim to grow alongside our customers, helping them succeed in an ever-evolving market.
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Core Values -->
        <div class="underlined-title">
            <div class="editContent">
                <h1 class="text-center latestitems">Our Core Values</h1>
            </div>
            <div class="wow-hr type_short">
                <span class="wow-hr-h">
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                </span>
            </div>
        </div>
        
        <div class="row values-section">
            <div class="col-md-4 fade-in">
                <div class="value-card">
                    <div class="value-icon">
                        <i class="fa fa-check-circle"></i>
                    </div>
                    <h3>Quality Excellence</h3>
                    <p>
                        We are committed to delivering products of the highest quality that meet or exceed industry standards. Our rigorous testing and quality control processes ensure reliability and performance in every application.
                    </p>
                    <div class="value-badge">
                        <span>ISO 9001 Certified</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 fade-in">
                <div class="value-card">
                    <div class="value-icon">
                        <i class="fa fa-users"></i>
                    </div>
                    <h3>Customer Focus</h3>
                    <p>
                        Our customers are at the heart of everything we do. We listen to their needs, provide responsive service, and develop solutions that address their specific challenges.
                    </p>
                    <div class="value-badge">
                        <span>Customer Satisfaction</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 fade-in">
                <div class="value-card">
                    <div class="value-icon">
                        <i class="fa fa-leaf"></i>
                    </div>
                    <h3>Sustainability</h3>
                    <p>
                        We are dedicated to developing environmentally responsible products and practices that minimize our ecological footprint while meeting performance requirements.
                    </p>
                    <div class="value-badge">
                        <span>Eco-Friendly Solutions</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row values-section mt-4">
            <div class="col-md-4 offset-md-2 fade-in">
                <div class="value-card">
                    <div class="value-icon">
                        <i class="fa fa-handshake-o"></i>
                    </div>
                    <h3>Integrity</h3>
                    <p>
                        We conduct our business with honesty, transparency, and ethical standards. We build trust through reliable products and fair business practices.
                    </p>
                    <div class="value-badge">
                        <span>Ethical Business</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 fade-in">
                <div class="value-card">
                    <div class="value-icon">
                        <i class="fa fa-lightbulb-o"></i>
                    </div>
                    <h3>Innovation</h3>
                    <p>
                        We continuously explore new technologies and methods to improve our products and processes, staying ahead of market trends and customer needs.
                    </p>
                    <div class="value-badge">
                        <span>Research & Development</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MILESTONES SECTION -->
<section class="milestones-section">
    <div class="container">
        <div class="underlined-title">
            <div class="editContent">
                <h1 class="text-center latestitems">Our Journey</h1>
            </div>
            <div class="wow-hr type_short">
                <span class="wow-hr-h">
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                </span>
            </div>
        </div>
        
        <div class="timeline">
            <div class="timeline-item fade-in">
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <h3>2005</h3>
                    <p>Deepotex Solutions was founded in Egypt, with a focus on construction adhesives.</p>
                </div>
            </div>
            
            <div class="timeline-item fade-in">
                <div class="timeline-dot"></div>
                <div class="timeline-content right">
                    <h3>2008</h3>
                    <p>Expanded product line to include industrial sealants and specialty adhesives.</p>
                </div>
            </div>
            
            <div class="timeline-item fade-in">
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <h3>2012</h3>
                    <p>Opened our state-of-the-art manufacturing facility to increase production capacity.</p>
                </div>
            </div>
            
            <div class="timeline-item fade-in">
                <div class="timeline-dot"></div>
                <div class="timeline-content right">
                    <h3>2015</h3>
                    <p>Celebrated 10 years of business and launched our eco-friendly product line.</p>
                </div>
            </div>
            
           
            
            <div class="timeline-item fade-in">
                <div class="timeline-dot"></div>
                <div class="timeline-content right">
                    <h3>2020</h3>
                    <p>Received ISO 9001 certification for our quality management systems.</p>
                </div>
            </div>

            <div class="timeline-item fade-in">
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <h3>2024</h3>
                    <p>Expanded operations to Saudi Arabia , establishing a regional presence.</p>
                </div>
            </div>
            
            <div class="timeline-item fade-in">
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <h3>Today</h3>
                    <p>Continuing to innovate and grow, serving clients across the Middle East with premium adhesive solutions.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CALL TO ACTION -->
<div class="item content cta-section">
    <div class="container text-center">
        <div class="cta-content fade-in">
            <h2>Ready to work with us?</h2>
            <p>Contact our team to discuss your adhesive and sealant needs.</p>
            <a asp-action="Contact" asp-controller="Home" class="homebrowseitems">
                Get in Touch
                <div class="homebrowseitemsicon">
                    <i class="fa fa-arrow-right"></i>
                </div>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add animation for elements
            const fadeElements = document.querySelectorAll('.fade-in');
            const observerOptions = {
                threshold: 0.2,
                rootMargin: '0px 0px -50px 0px'
            };
            
            const appearOnScroll = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animated');
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);
            
            fadeElements.forEach(element => {
                appearOnScroll.observe(element);
            });
        });
    </script>
}
